# Образец /var/www/schoolpiboard/.env — состав задан разделом 10.3.
#
# НАСТОЯЩИЙ ФАЙЛ ЖИВЁТ ТОЛЬКО НА СЕРВЕРЕ, права 600, владелец boardsvc.
# Здесь — имена переменных и пояснения, без единого значения.
#
# Паролей Робокассы здесь нет и быть не должно: доска в Робокассу не ходит,
# счёт заводит сервер ключей. Это пункт 13.7 приёмки.

# Адрес и порт. Только петлевой: наружу выпускает nginx.
# Задан в юните службы, здесь дублировать не нужно.
# ASPNETCORE_URLS=http://127.0.0.1:5081

# Подключение к своей базе. Пользователь базы отдельный от того, под которым
# работает основной сайт.
DATABASE_URL=Host=localhost;Database=schoolpiboard;Username=boardsvc;Password=

# Redis: свой номер базы и пароль, слушает только 127.0.0.1.
REDIS_URL=localhost:6379,password=,defaultDatabase=1

# Подпись токенов входа. Генерировать: openssl rand -hex 32
# Служба не поднимется, если ключ короче 32 символов или похож на заглушку.
JWT_SIGNING_KEY=

# Внешний адрес доски. Из него собираются ссылки в письмах: ошибка здесь —
# и письма уйдут со ссылками в никуда.
PUBLIC_URL=https://board.school-pi.online

# Сервер ключей: он и только он общается с Робокассой.
LICENSE_SERVER_URL=https://keys.school-pi.online
# Общий секрет, которым подписан обратный вызов об оплате. Такой же лежит
# в .env сервера ключей. Генерировать: openssl rand -hex 32
LICENSE_SHARED_SECRET=

# Почта. В MAIL_PASSWORD кладётся пароль приложения из Яндекс ID,
# а не пароль от ящика: обычный пароль SMTP не примет.
MAIL_SERVER=smtp.yandex.ru
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Yandex Object Storage для картинок на доске. Нужен с этапа 11d;
# до него служба поднимается и без этих значений, предупреждая в логе.
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Пробный период и отсрочка перед удалением содержимого после окончания
# подписки. Значения по умолчанию совпадают с заданием.
TRIAL_DAYS=7
GRACE_DAYS=60
